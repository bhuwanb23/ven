<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        margin: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #131313;
        font-family: "Geist", system-ui, sans-serif;
        color: #e5e2e1;
      }

      .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      /* ── Shared ═══════════════════════════════════════════ */
      .terminal-chrome {
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 20px;
        background: #201f1f;
        border-bottom: 2px solid #3a494b;
      }
      .dot { width: 14px; height: 14px; border-radius: 50%; }
      .dot-r { background: #ff5f57; }
      .dot-y { background: #febc2e; }
      .dot-g { background: #28c840; }
      .term-title {
        font-family: "JetBrains Mono", monospace;
        font-size: 18px;
        color: #f5fafa;
        margin-left: 8px;
      }
      .term-body {
        padding: 28px 32px;
        font-family: "JetBrains Mono", monospace;
        font-size: 24px;
        line-height: 1.65;
      }
      .cmd { color: #00e639; }
      .out { color: #b9cacb; }
      .err { color: #ffb4ab; }
      .conflict { color: #ffb4ab; font-weight: 600; }
      .success { color: #00e639; }
      .cyan-text { color: #00dbe7; }
      .muted-text { color: #849495; }

      /* ── Decorative Shared Elements ══════════════════════ */
      body::after {
        content: ''; position: fixed; inset: 0;
        opacity: 0.025; pointer-events: none; z-index: 999;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        background-repeat: repeat; background-size: 256px 256px;
      }
      .stripe-overlay {
        position: absolute; inset: 0; pointer-events: none; opacity: 0.04;
        background: repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(0,219,231,0.12) 40px, rgba(0,219,231,0.12) 42px);
      }
      .corner-bracket {
        position: absolute; width: 32px; height: 32px;
        border-color: #00dbe7; border-style: solid;
        opacity: 0.2; pointer-events: none;
      }
      .corner-bracket.tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; }
      .corner-bracket.tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
      .corner-bracket.bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; }
      .corner-bracket.br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; }
      .diamond {
        width: 10px; height: 10px; background: #00dbe7;
        transform: rotate(45deg); opacity: 0.15;
        position: absolute; pointer-events: none;
      }
      .particle-dot {
        position: absolute; width: 8px; height: 8px;
        border-radius: 50%; pointer-events: none;
      }
      .particle-dot.cyan { background: #00dbe7; }
      .particle-dot.green { background: #00e639; }
      .version-chip {
        display: inline-flex; align-items: center;
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        padding: 3px 10px; border-radius: 3px;
        background: rgba(0,219,231,0.1);
        border: 1px solid rgba(0,219,231,0.25); color: #00dbe7;
      }
      .warning-badge {
        display: flex; align-items: center; gap: 6px;
        font-family: "JetBrains Mono", monospace; font-size: 18px;
        padding: 6px 16px;
        background: rgba(255,59,48,0.12);
        border: 1px solid rgba(255,59,48,0.3);
        border-radius: 4px; color: #ffb4ab;
      }
      .progress-bar {
        height: 4px; background: #3a494b; border-radius: 2px; overflow: hidden;
      }
      .progress-bar-fill {
        height: 100%; background: #00dbe7; border-radius: 2px;
      }
      .scan-wave {
        position: absolute; width: 100%; height: 3px;
        background: linear-gradient(90deg, transparent, #00dbe7, transparent);
        opacity: 0.25; pointer-events: none;
      }
      .shield-icon {
        display: flex; align-items: center; justify-content: center;
        width: 48px; height: 48px;
        border: 2px solid #00e639; border-radius: 50%;
        color: #00e639; font-size: 24px; position: absolute;
      }
      .network-node {
        position: absolute; width: 8px; height: 8px;
        border-radius: 50%; background: #00dbe7; pointer-events: none;
      }
      .network-line {
        position: absolute; height: 1px;
        background: rgba(0,219,231,0.12);
        transform-origin: left center; pointer-events: none;
      }
      .status-ticker {
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        color: #00e639; display: flex; align-items: center; gap: 6px;
      }
      .cve-badge {
        display: inline-flex; align-items: center; gap: 4px;
        font-family: "JetBrains Mono", monospace; font-size: 14px;
        padding: 2px 8px; border-radius: 3px;
      }
      .cve-badge.safe { background: rgba(0,230,57,0.1); color: #00e639; border: 1px solid rgba(0,230,57,0.2); }
      .star-particle {
        position: absolute; width: 4px; height: 4px;
        background: #00dbe7; border-radius: 50%; pointer-events: none;
      }
      .ghost-bar-chart {
        display: flex; gap: 8px; align-items: flex-end;
        height: 50px; margin: 12px 0;
      }
      .ghost-bar {
        flex: 1; border-radius: 2px 2px 0 0; min-height: 4px;
      }
      .ghost-bar.g1 { background: #ffb4ab; }
      .ghost-bar.g2 { background: #ff8a80; }
      .ghost-bar.g3 { background: #ff5252; }
      .ghost-bar.g4 { background: #ff1744; }

      /* ── Scene 1: Chaos ────────────────────────────────── */
      #scene1 { z-index: 1; background: #131313; }
      #scene1 .dot-grid {
        position: absolute; inset: 0;
        opacity: 0.1;
        background-image: radial-gradient(circle, #00dbe7 1px, transparent 1px);
        background-size: 48px 48px;
      }
      #scene1 .ghost-term {
        position: absolute;
        width: 380px; height: 220px;
        border: 1px solid rgba(0, 219, 231, 0.08);
        border-radius: 6px;
        background: rgba(14, 14, 14, 0.5);
      }
      #scene1 .gt1 { top: 80px; right: 60px; transform: rotate(3deg); }
      #scene1 .gt2 { bottom: 100px; left: 80px; transform: rotate(-2deg); }
      #scene1 .scene-content {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        width: 100%; height: 100%;
        padding: 80px 160px; gap: 0;
      }
      #scene1 .main-term {
        width: 100%; max-width: 1100px;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
      }
      #scene1 .term-body-sc1 {
        padding: 28px 36px;
        font-family: "JetBrains Mono", monospace;
        font-size: 26px;
        line-height: 1.7;
      }
      #scene1 .err-block {
        display: inline-block;
        background: rgba(255, 59, 48, 0.12);
        border-left: 4px solid #ff3b30;
        padding: 6px 16px;
        margin: 4px 0;
        border-radius: 0 4px 4px 0;
      }
      #scene1 .elapsed {
        margin-top: 20px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
        color: #8aa8a9;
        letter-spacing: 0.08em;
      }
      #scene1 .warning-badge { position: absolute; top: 30px; right: 30px; }
      #scene1 .err-counter {
        position: absolute; bottom: 30px; right: 30px;
        font-family: "JetBrains Mono", monospace; font-size: 16px;
        color: #ffb4ab; opacity: 0.5;
      }
      #scene1 .s1-ghost-extra {
        position: absolute; width: 320px; height: 180px;
        border: 1px solid rgba(0,219,231,0.06);
        border-radius: 6px;
        background: rgba(14,14,14,0.4);
        pointer-events: none;
      }
      #scene1 .s1-ghost-extra.gt3 { bottom: 120px; right: 180px; transform: rotate(5deg); }
      #scene1 .s1-ghost-extra.gt4 { top: 200px; left: 40px; transform: rotate(-4deg); }
      #scene1 .diamond-s1 {
        position: absolute;
        width: 8px; height: 8px;
        background: rgba(255,59,48,0.15);
        transform: rotate(45deg);
        pointer-events: none;
      }

      /* ── Scene 2: Problem ──────────────────────────────── */
      #scene2 { z-index: 2; background: #131313; opacity: 0; }
      #scene2 .accent-line {
        position: absolute; top: 0; left: 0;
        width: 6px; height: 100%;
        background: #00dbe7;
      }
      #scene2 .ghost-bg {
        position: absolute;
        font-family: "JetBrains Mono", monospace;
        font-size: 200px;
        color: rgba(0, 219, 231, 0.04);
        top: 50%; right: -200px;
        transform: translateY(-50%) rotate(-6deg);
        white-space: nowrap;
        pointer-events: none;
      }
      #scene2 .s2-progress-wrap {
        position: absolute; bottom: 40px; left: 140px; right: 120px;
      }
      #scene2 .s2-versions {
        position: absolute; top: 60px; right: 40px;
        display: flex; gap: 12px;
      }
      #scene2 .s2-diamond {
        position: absolute; width: 8px; height: 8px;
        background: rgba(0,219,231,0.12);
        transform: rotate(45deg); pointer-events: none;
      }
      #scene2 .scene-content {
        display: flex; flex-direction: row;
        align-items: center;
        width: 100%; height: 100%;
        padding: 100px 120px 100px 140px;
        gap: 80px;
      }
      #scene2 .copy {
        flex: 1;
        display: flex; flex-direction: column;
        gap: 20px;
      }
      #scene2 .eyebrow {
        font-family: "JetBrains Mono", monospace;
        font-size: 22px; color: #00dbe7;
        letter-spacing: 0.12em; text-transform: uppercase;
      }
      #scene2 .headline {
        font-size: 72px; font-weight: 700;
        line-height: 1.1; letter-spacing: -0.03em;
        color: #e5e2e1;
      }
      #scene2 .body {
        font-size: 32px; color: #b9cacb;
        line-height: 1.5; max-width: 680px;
      }
      #scene2 .terminal {
        flex: 1; max-width: 820px;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
      }
      #scene2 .term-body-sc2 {
        padding: 28px 32px;
        font-family: "JetBrains Mono", monospace;
        font-size: 24px; line-height: 1.65;
      }

      /* ── Scene 3: Meet ven ─────────────────────────────── */
      #scene3 { z-index: 3; background: #131313; opacity: 0; }
      #scene3 .glow {
        position: absolute;
        width: 900px; height: 900px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0, 219, 231, 0.18) 0%, transparent 65%);
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      #scene3 .ghost-ring {
        position: absolute;
        width: 400px; height: 400px;
        border: 3px solid rgba(0, 219, 231, 0.1);
        border-radius: 50%;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      #scene3 .pulse-ring {
        position: absolute;
        width: 200px; height: 200px;
        border: 2px solid rgba(0,219,231,0.12);
        border-radius: 50%;
        top: 50%; left: 50%;
        transform: translate(-50%,-50%) scale(1);
        pointer-events: none;
      }
      #scene3 .s3-version-meta {
        font-family: "JetBrains Mono", monospace;
        font-size: 18px; color: #849495;
        letter-spacing: 0.04em;
      }
      #scene3 .logo-frame {
        position: absolute;
        width: 168px; height: 168px;
        border-radius: 50%;
        border: 2px solid rgba(0,219,231,0.08);
        top: 50%; left: 50%;
        transform: translate(-50%,-50%);
        pointer-events: none;
      }
      #scene3 .scene-content {
        display: flex; flex-direction: column;
        justify-content: center;
        width: 100%; height: 100%;
        padding: 80px 160px; gap: 24px;
      }
      #scene3 .logo-row {
        display: flex; align-items: center; gap: 32px;
        margin-bottom: 12px;
      }
      #scene3 .logo {
        width: 140px; height: 140px;
        border-radius: 50%;
        border: 3px solid rgba(0, 219, 231, 0.45);
        box-shadow: 0 0 60px rgba(0, 219, 231, 0.25);
        object-fit: contain; padding: 16px;
        background: #201f1f;
      }
      #scene3 .logo-text {
        font-size: 100px; font-weight: 700;
        color: #e1fdff; letter-spacing: -0.04em;
      }
      #scene3 .subtitle {
        font-size: 36px; color: #b9cacb;
        max-width: 900px; line-height: 1.4;
      }
      #scene3 .split-panel {
        display: flex; gap: 48px;
        margin-top: 8px;
        height: 400px;
      }
      #scene3 .file-tree {
        flex: 0 0 340px;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        padding: 24px 28px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
        line-height: 2;
      }
      #scene3 .ft-header {
        color: #849495;
        border-bottom: 1px solid #3a494b;
        padding-bottom: 12px;
        margin-bottom: 12px;
      }
      #scene3 .ft-item { color: #b9cacb; }
      #scene3 .ft-active {
        color: #00dbe7; font-weight: 600;
      }
      #scene3 .term-panel {
        flex: 1;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
      }
      #scene3 .sw-term-body {
        padding: 20px 28px;
        font-family: "JetBrains Mono", monospace;
        font-size: 22px; line-height: 1.7;
      }

      /* ── Scene 4: Languages ────────────────────────────── */
      #scene4 { z-index: 4; background: #131313; opacity: 0; }
      #scene4 .bg-grid {
        position: absolute; inset: 0;
        opacity: 0.08;
        background-image: radial-gradient(circle, #00dbe7 1px, transparent 1px);
        background-size: 48px 48px;
      }
      #scene4 .scene-content {
        display: flex; flex-direction: column;
        width: 100%; height: 100%;
        padding: 80px 120px; gap: 32px;
      }
      #scene4 .headline {
        font-size: 72px; font-weight: 700;
        color: #e1fdff;
      }
      #scene4 .sub {
        font-size: 28px; color: #b9cacb;
      }
      #scene4 .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        flex: 1; align-content: center;
      }
      #scene4 .lang-card {
        background: #201f1f;
        border: 2px solid #3a494b;
        border-radius: 8px;
        padding: 24px 20px;
        display: flex; flex-direction: column;
        gap: 6px;
      }
      #scene4 .lang-name {
        font-size: 30px; font-weight: 600;
        color: #e5e2e1;
      }
      #scene4 .lang-cmd {
        font-family: "JetBrains Mono", monospace;
        font-size: 18px; color: #00a3ad;
      }
      #scene4 .s4-ghost-term {
        position: absolute; top: 60px; right: 30px;
        width: 260px; height: 80px;
        border: 1px solid rgba(0,219,231,0.08);
        border-radius: 6px;
        background: rgba(14,14,14,0.4);
        display: flex; align-items: center; justify-content: center;
        font-family: "JetBrains Mono", monospace;
        font-size: 16px; color: rgba(0,219,231,0.3);
        pointer-events: none;
      }
      #scene4 .s4-diamond {
        position: absolute; width: 8px; height: 8px;
        background: rgba(0,219,231,0.1);
        transform: rotate(45deg); pointer-events: none;
      }

      /* ── Scene 5: Ghost Scan ───────────────────────────── */
      #scene5 { z-index: 5; background: #131313; opacity: 0; }
      #scene5 .scan-lines {
        position: absolute; inset: 0;
        opacity: 0.04;
        background: repeating-linear-gradient(
          0deg, transparent, transparent 3px, rgba(0, 219, 231, 0.15) 3px, rgba(0, 219, 231, 0.15) 4px
        );
        pointer-events: none;
      }
      #scene5 .ghost-toml {
        position: absolute;
        font-family: "JetBrains Mono", monospace;
        font-size: 160px;
        color: rgba(0, 219, 231, 0.03);
        top: 10%; right: -200px;
        transform: rotate(-4deg);
        white-space: nowrap;
        pointer-events: none;
      }
      #scene5 .scene-content {
        display: flex; flex-direction: column;
        width: 100%; height: 100%;
        padding: 60px 100px; gap: 28px;
      }
      #scene5 .headline {
        font-size: 64px; font-weight: 700;
        color: #e1fdff;
      }
      #scene5 .sub {
        font-size: 28px; color: #b9cacb;
      }
      #scene5 .split {
        display: flex; gap: 40px;
        flex: 1;
      }
      #scene5 .toml-panel {
        flex: 0 0 400px;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        padding: 24px 28px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
        line-height: 1.8;
      }
      #scene5 .tl-section { color: #00dbe7; font-weight: 600; }
      #scene5 .tl-key { color: #e1fdff; }
      #scene5 .tl-val { color: #00e639; }
      #scene5 .term-panel {
        flex: 1;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
      }
      #scene5 .ghost-term-body {
        padding: 20px 28px;
        font-family: "JetBrains Mono", monospace;
        font-size: 22px; line-height: 1.7;
      }
      #scene5 .ghost-chip {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(255, 180, 171, 0.12);
        border: 2px solid #ffb4ab;
        border-radius: 4px;
        padding: 8px 16px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px; color: #ffb4ab;
        margin: 6px 0;
      }
      #scene5 .stats-bar {
        display: flex; gap: 32px;
        padding: 16px 24px;
        background: #201f1f;
        border: 2px solid #3a494b;
        border-radius: 6px;
        margin-top: auto;
      }
      #scene5 .stat-item {
        font-family: "JetBrains Mono", monospace;
        font-size: 20px; color: #849495;
      }
      #scene5 .stat-val { color: #b9cacb; font-weight: 600; }
      #scene5 .stat-ok { color: #00e639; }

      /* ── Scene 6: Security ─────────────────────────────── */
      #scene6 { z-index: 6; background: #1a1a1a; opacity: 0; }
      #scene6 .mesh-bg {
        position: absolute; inset: 0;
        opacity: 0.05;
        background-image:
          radial-gradient(circle at 30% 40%, rgba(0, 255, 65, 0.12) 0%, transparent 50%),
          radial-gradient(circle at 70% 60%, rgba(0, 219, 231, 0.08) 0%, transparent 50%);
      }
      #scene6 .scene-content {
        display: flex; flex-direction: column;
        width: 100%; height: 100%;
        padding: 70px 100px; gap: 24px;
      }
      #scene6 .headline {
        font-size: 64px; font-weight: 700;
        color: #e1fdff;
      }
      #scene6 .sub {
        font-size: 28px; color: #b9cacb;
      }
      #scene6 .panels {
        display: flex; gap: 32px;
        flex: 1;
      }
      #scene6 .panel {
        flex: 1;
        background: #0e0e0e;
        border: 2px solid #3a494b;
        border-radius: 8px;
        overflow: hidden;
      }
      #scene6 .p-body {
        padding: 20px 24px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px; line-height: 1.7;
      }
      #scene6 .bar-chart {
        display: flex; gap: 12px;
        align-items: flex-end; height: 60px;
        margin: 12px 0;
      }
      #scene6 .bar {
        flex: 1; height: 8px;
        background: #00e639;
        border-radius: 2px;
        opacity: 0.7;
      }
      #scene6 .bar-wrap {
        display: flex; flex-direction: column; align-items: center;
        gap: 4px; flex: 1;
      }
      #scene6 .bar-label {
        font-family: "JetBrains Mono", monospace;
        font-size: 12px; color: #849495;
      }
      #scene6 .badge-row {
        display: flex; gap: 16px;
        margin-top: auto;
      }
      #scene6 .badge {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 20px;
        border-radius: 4px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
      }
      #scene6 .badge-green {
        background: rgba(0, 230, 57, 0.1);
        border: 2px solid #00e639;
        color: #00e639;
      }
      #scene6 .badge-cyan {
        background: rgba(0, 219, 231, 0.1);
        border: 2px solid #00dbe7;
        color: #00dbe7;
      }

      /* ── Scene 7: CTA ──────────────────────────────────── */
      #scene7 { z-index: 7; background: #131313; opacity: 0; }
      #scene7 .glow {
        position: absolute;
        width: 1000px; height: 1000px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0, 219, 231, 0.15) 0%, transparent 65%);
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      #scene7 .ghost-ring {
        position: absolute;
        width: 480px; height: 480px;
        border: 3px solid rgba(0, 219, 231, 0.08);
        border-radius: 50%;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      #scene7 .scene-content {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        width: 100%; height: 100%;
        padding: 80px 160px; gap: 28px;
        text-align: center;
      }
      #scene7 .logo {
        width: 160px; height: 160px;
        border-radius: 50%;
        border: 3px solid rgba(0, 219, 231, 0.5);
        box-shadow: 0 0 60px rgba(0, 219, 231, 0.3);
        object-fit: contain; padding: 18px;
        background: #201f1f;
      }
      #scene7 .headline {
        font-size: 88px; font-weight: 700;
        color: #e1fdff; letter-spacing: -0.03em;
      }
      #scene7 .install-block {
        font-family: "JetBrains Mono", monospace;
        font-size: 36px; color: #00e639;
        background: #0e0e0e;
        border: 2px solid rgba(0, 219, 231, 0.4);
        border-radius: 8px;
        padding: 24px 48px;
        box-shadow: 0 0 40px rgba(0, 219, 231, 0.1);
      }
      #scene7 .platforms {
        font-family: "JetBrains Mono", monospace;
        font-size: 28px; color: #00dbe7;
      }
      #scene7 .tagline {
        font-size: 32px; color: #b9cacb;
        max-width: 800px;
      }
      #scene7 .footnote {
        font-family: "JetBrains Mono", monospace;
        font-size: 22px; color: #849495;
      }
    </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="ven-promo-v2"
      data-start="0"
      data-duration="120"
      data-width="1920"
      data-height="1080"
    >

      <!-- ═══ Scene 1: Chaos ═══ -->
      <div id="scene1" class="scene">
        <div class="dot-grid" id="s1-grid"></div>
        <div class="stripe-overlay" id="s1-stripe"></div>
        <div class="ghost-term gt1" id="s1-gt1"></div>
        <div class="ghost-term gt2" id="s1-gt2"></div>
        <div class="s1-ghost-extra gt3" id="s1-gt3"></div>
        <div class="s1-ghost-extra gt4" id="s1-gt4"></div>
        <div class="diamond-s1" style="top:120px; left:100px;" id="s1-d1"></div>
        <div class="diamond-s1" style="top:200px; left:140px;" id="s1-d2"></div>
        <div class="warning-badge" id="s1-warn"><span>⚠</span><span>4 unresolved conflicts</span></div>
        <div class="err-counter" id="s1-err-count">✗ ERRORS: 3</div>
        <div class="scene-content">
          <div class="main-term" id="s1-terminal">
            <div class="term-bar">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
              <span class="term-title">~/projects/api — bash</span>
            </div>
            <div class="term-body-sc1">
              <div class="cmd" id="s1-c1">$ npm install express</div>
              <div class="err" id="s1-e1"><span class="err-block">✗ ERESOLVE — peer dependency conflict</span></div>
              <div class="cmd" id="s1-c2">$ pip install django</div>
              <div class="err" id="s1-e2"><span class="err-block">✗ django 5.0 requires python >=3.10, have 3.8</span></div>
              <div class="cmd" id="s1-c3">$ nvm use 18</div>
              <div class="err" id="s1-e3"><span class="err-block">✗ version 18 not installed</span></div>
              <div class="cmd" id="s1-c4">$ npx create-react-app</div>
              <div class="out" id="s1-o4">(node:1234) UnhandledPromiseRejectionWarning</div>
            </div>
          </div>
          <div class="elapsed" id="s1-elapsed">⏱ 2 hours debugging · 3 tools · 0 answers</div>
        </div>
      </div>

      <!-- ═══ Scene 2: Problem ═══ -->
      <div id="scene2" class="scene">
        <div class="accent-line" id="s2-line"></div>
        <div class="stripe-overlay" id="s2-stripe"></div>
        <div class="ghost-bg" id="s2-ghost" data-layout-ignore data-layout-allow-overflow>npm install</div>
        <div class="s2-versions" id="s2-versions">
          <span class="version-chip">npm 10.8</span>
          <span class="version-chip" style="border-color:rgba(255,180,171,0.3); color:#ffb4ab;">pip 24.0 ✗</span>
        </div>
        <div class="s2-diamond" style="top:180px; right:180px;" id="s2-d1"></div>
        <div class="s2-diamond" style="top:220px; right:220px;" id="s2-d2"></div>
        <div class="s2-progress-wrap" id="s2-progress-wrap">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
            <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#6a8a8b;">debug progress</span>
            <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#6a8a8b;">62%</span>
          </div>
          <div class="progress-bar"><div class="progress-bar-fill" id="s2-progress" style="width:62%;"></div></div>
        </div>
        <div class="scene-content">
          <div class="copy">
            <div class="eyebrow" id="s2-eyebrow">The problem</div>
            <h2 class="headline" id="s2-headline">
              Every tool installs first.<br />Breaks second.
            </h2>
            <p class="body" id="s2-body">
              npm, pip, nvm — reactive managers that never explain why things
              break. ven analyzes your entire graph before touching your environment.
            </p>
          </div>
          <div class="terminal" id="s2-terminal">
            <div class="term-bar">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
              <span class="term-title">~/projects/api</span>
            </div>
            <div class="term-body-sc2">
              <div class="cmd" id="s2-c1">$ npm install axios</div>
              <div class="out" id="s2-o1">✓ added 1 package</div>
              <div class="cmd" id="s2-c2">$ npm install express</div>
              <div class="conflict" id="s2-o2">
                ✗ ERESOLVE — peer dependency conflict
              </div>
              <div class="err" id="s2-o3">→ spend 2 hours debugging</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Scene 3: Meet ven + Auto-Switch ═══ -->
      <div id="scene3" class="scene">
        <div class="glow" id="s3-glow"></div>
        <div class="ghost-ring" id="s3-ring"></div>
        <div class="pulse-ring" id="s3-pulse-ring"></div>
        <div class="logo-frame" id="s3-logo-frame"></div>
        <div class="particle-dot cyan" style="top:43%; left:44%;" id="s3-p0"></div>
        <div class="particle-dot cyan" style="top:40%; left:52%;" id="s3-p1"></div>
        <div class="particle-dot green" style="top:48%; left:56%;" id="s3-p2"></div>
        <div class="particle-dot cyan" style="top:56%; left:52%;" id="s3-p3"></div>
        <div class="particle-dot green" style="top:54%; left:44%;" id="s3-p4"></div>
        <div class="particle-dot cyan" style="top:46%; left:40%;" id="s3-p5"></div>
        <div class="scene-content">
          <div class="logo-row" id="s3-logo-row">
            <img class="logo" id="s3-logo" src="assets/Ven_logo.png" alt="ven" crossorigin="anonymous" data-hf-skip-duplicate-check />
            <span class="logo-text" id="s3-logo-text">ven</span>
          </div>
          <h1 class="subtitle" id="s3-subtitle" style="margin-bottom:4px;">
            The Intelligent Version &amp; Dependency Manager
          </h1>
          <div class="s3-version-meta" id="s3-version-meta">v0.2.1 · Rust · MIT</div>

          <!-- Auto-switch demo panel (appears after logo reveal fades) -->
          <div class="split-panel" id="s3-split">
            <div class="file-tree" id="s3-tree">
              <div class="ft-header">~/projects /</div>
              <div class="ft-item">├── frontend/</div>
              <div class="ft-active" id="s3-tree-active">│   └── <span class="cyan-text">◉ node 20.20.2</span></div>
              <div class="ft-item">├── backend/</div>
              <div class="ft-item">│   ├── node 22.11.0</div>
              <div class="ft-item">│   └── python 3.11.5</div>
              <div class="ft-item">└── systems/</div>
              <div class="ft-item">    └── rust 1.75.0</div>
            </div>
            <div class="term-panel" id="s3-term">
              <div class="term-bar">
                <span class="dot dot-r"></span>
                <span class="dot dot-y"></span>
                <span class="dot dot-g"></span>
                <span class="term-title">ven — auto-switch</span>
              </div>
              <div class="sw-term-body">
                <div class="cmd" id="s3-sw-c1">$ cd ~/projects/frontend</div>
                <div class="success" id="s3-sw-o1">✓ node v20.20.2 · activated</div>
                <div class="cmd" id="s3-sw-c2">$ cd ~/projects/backend</div>
                <div class="success" id="s3-sw-o2">✓ node v22.11.0 · python 3.11.5 · activated</div>
                <div class="muted-text" id="s3-sw-info">↳ zero commands · zero config · auto-switch</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Scene 4: Languages ═══ -->
      <div id="scene4" class="scene">
        <div class="bg-grid" id="s4-grid-bg"></div>
        <div class="s4-ghost-term" id="s4-term-badge" data-layout-ignore>◉ 8/8 runtimes ready</div>
        <div class="s4-diamond" style="top:160px; left:80px;" id="s4-d1"></div>
        <div class="s4-diamond" style="top:180px; right:100px;" id="s4-d2"></div>
        <div class="scene-content">
          <h2 class="headline" id="s4-headline">8 languages. One interface.</h2>
          <p class="sub" id="s4-sub">Same command, same mental model — every runtime you need.</p>
          <div class="grid" id="s4-grid">
            <div class="lang-card" id="s4-c0">
              <div class="lang-name"><span class="color-dot active"></span>Node.js</div>
              <div class="lang-cmd">ven install node 22 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">22.11</span></div>
            </div>
            <div class="lang-card" id="s4-c1">
              <div class="lang-name"><span class="color-dot active"></span>Python</div>
              <div class="lang-cmd">ven install python 3.11 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">3.11.5</span></div>
            </div>
            <div class="lang-card" id="s4-c2">
              <div class="lang-name"><span class="color-dot active"></span>Go</div>
              <div class="lang-cmd">ven install go 1.21 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">1.21.0</span></div>
            </div>
            <div class="lang-card" id="s4-c3">
              <div class="lang-name"><span class="color-dot active"></span>Rust</div>
              <div class="lang-cmd">ven install rust 1.75 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">1.75.0</span></div>
            </div>
            <div class="lang-card" id="s4-c4">
              <div class="lang-name"><span class="color-dot active"></span>Java</div>
              <div class="lang-cmd">ven install java 17 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">17.0.9</span></div>
            </div>
            <div class="lang-card" id="s4-c5">
              <div class="lang-name"><span class="color-dot active"></span>Deno</div>
              <div class="lang-cmd">ven install deno 1.40 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">1.40.5</span></div>
            </div>
            <div class="lang-card" id="s4-c6">
              <div class="lang-name"><span class="color-dot active"></span>Bun</div>
              <div class="lang-cmd">ven install bun 1.0 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">1.0.35</span></div>
            </div>
            <div class="lang-card" id="s4-c7">
              <div class="lang-name"><span class="color-dot active"></span>Ruby</div>
              <div class="lang-cmd">ven install ruby 3.2 <span class="version-chip" style="font-size:13px; padding:2px 6px; opacity:0;">3.2.2</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Scene 5: Ghost Dependency Scan ═══ -->
      <div id="scene5" class="scene">
        <div class="scan-lines" id="s5-scan"></div>
        <div class="scan-wave" id="s5-scan-wave" style="top:0;"></div>
        <div class="ghost-toml" id="s5-ghost-toml" data-layout-ignore data-layout-allow-overflow>ven.toml</div>
        <div class="corner-bracket tl" id="s5-br-tl"></div>
        <div class="corner-bracket tr" id="s5-br-tr"></div>
        <div class="corner-bracket bl" id="s5-br-bl"></div>
        <div class="corner-bracket br" id="s5-br-br"></div>
        <div class="scene-content">
          <h2 class="headline" id="s5-headline">Know your dependencies. Every one.</h2>
          <p class="sub" id="s5-sub">Detect ghost imports, auto-switch runtimes, scan for CVEs.</p>
          <div class="split">
            <div class="toml-panel" id="s5-toml">
              <div class="tl-section">[runtime]</div>
              <div><span class="tl-key">node</span> = <span class="tl-val">"20"</span></div>
              <div><span class="tl-key">python</span> = <span class="tl-val">"3.11"</span></div>
              <div><span class="tl-key">go</span> = <span class="tl-val">"1.21"</span></div>
              <div style="margin-top:12px; border-top:1px solid #3a494b; padding-top:12px;">
                <div class="tl-section">[packages]</div>
                <div><span class="tl-key">express</span> = <span class="tl-val">"4.18"</span></div>
                <div><span class="tl-key">axios</span> = <span class="tl-val">"^1.6"</span></div>
                <div><span class="tl-key">lodash</span> = <span class="tl-val" style="color:#ffb4ab;">"*"</span></div>
              </div>
              <div style="margin-top:12px; border-top:1px solid #3a494b; padding-top:12px;">
                <div class="tl-section">[env]</div>
                <div><span class="tl-key">NODE_ENV</span> = <span class="tl-val">"development"</span></div>
              </div>
            </div>
            <div class="term-panel" id="s5-terminal">
              <div class="term-bar">
                <span class="dot dot-r"></span>
                <span class="dot dot-y"></span>
                <span class="dot dot-g"></span>
                <span class="term-title">ven — ghost scan</span>
              </div>
              <div class="ghost-term-body">
                <div class="success" id="s5-o1">✓ node 20.20.2 · python 3.11.5 · go 1.21.0</div>
                <div class="cmd" id="s5-c1">$ ven scan --ghosts</div>
                <div class="muted-text" id="s5-o2">→ Walking source tree (gitignore-aware)...</div>
                <div class="out" id="s5-o3">Found 3 undeclared imports:</div>
                <div class="ghost-chip" id="s5-ghost1">👻 lodash — src/utils.js:12</div>
                <div class="ghost-chip" id="s5-ghost2">👻 chalk — src/cli.js:4</div>
                <div class="ghost-chip" id="s5-ghost3">👻 dayjs — src/dates.js:7</div>
                <div class="cmd" id="s5-c2">$ ven scan --ghosts --fix</div>
                <div class="success" id="s5-o4">✓ 3 ghosts added to ven.toml [packages]</div>
              </div>
            </div>
          </div>
          <div style="display:flex; gap:24px; align-items:center;">
            <div class="ghost-bar-chart" id="s5-ghost-chart">
              <div class="ghost-bar g1" style="height:20px;" id="s5-gb1"></div>
              <div class="ghost-bar g2" style="height:32px;" id="s5-gb2"></div>
              <div class="ghost-bar g3" style="height:16px;" id="s5-gb3"></div>
              <div class="ghost-bar g4" style="height:8px;" id="s5-gb4"></div>
            </div>
            <div class="stats-bar" id="s5-stats">
              <span class="stat-item">Declared: <span class="stat-val">14</span></span>
              <span class="stat-item">Ghosts found: <span class="stat-val" style="color:#ffb4ab;">3</span></span>
              <span class="stat-item">Fixed: <span class="stat-ok">✓ 3</span></span>
              <span class="stat-item">Auto-switch: <span class="stat-ok">✓ 3 runtimes</span></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Scene 6: Security ═══ -->
      <div id="scene6" class="scene">
        <div class="mesh-bg" id="s6-mesh"></div>
        <div class="shield-icon" id="s6-shield" style="top:30px; left:30px;">⬡</div>
        <div class="network-node" id="s6-n0" style="top:120px; right:100px;"></div>
        <div class="network-node" id="s6-n1" style="top:160px; right:140px;"></div>
        <div class="network-node" id="s6-n2" style="top:140px; right:200px;"></div>
        <div class="network-line" id="s6-l0" style="top:124px; right:100px; width:60px; transform:rotate(-20deg);"></div>
        <div class="network-line" id="s6-l1" style="top:164px; right:140px; width:50px; transform:rotate(15deg);"></div>
        <div class="status-ticker" id="s6-ticker" style="position:absolute; top:100px; right:30px;">◉ scanning ...</div>
        <div class="scene-content">
          <h2 class="headline" id="s6-headline">Production-ready security.</h2>
          <p class="sub" id="s6-sub">CVE scanning · EOL alerts · lockfile integrity · team sync</p>
          <div class="panels">
            <div class="panel" id="s6-p1">
              <div class="term-bar">
                <span class="dot dot-r"></span>
                <span class="dot dot-y"></span>
                <span class="dot dot-g"></span>
                <span class="term-title">ven check</span>
              </div>
              <div class="p-body">
                <div class="cmd">$ ven check --security</div>
                <div class="out" style="margin-top:8px;">Scanning 8 ecosystems...</div>
                <div class="success">✓ npm: 0 CVEs</div>
                <div class="success">✓ PyPI: 0 CVEs</div>
                <div class="success">✓ crates.io: 0 CVEs</div>
                <div class="success">✓ Go: 0 CVEs</div>
                <div class="bar-chart" id="s6-chart">
                  <div class="bar-wrap"><div class="bar" id="s6-bar0" style="height:8px;"></div><span class="bar-label">npm</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar1" style="height:6px;"></div><span class="bar-label">PyPI</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar2" style="height:4px;"></div><span class="bar-label">Go</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar3" style="height:10px;"></div><span class="bar-label">crates</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar4" style="height:5px;"></div><span class="bar-label">Java</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar5" style="height:7px;"></div><span class="bar-label">Ruby</span></div>
                  <div class="bar-wrap"><div class="bar" id="s6-bar6" style="height:3px;"></div><span class="bar-label">Deno</span></div>
                </div>
              </div>
            </div>
            <div class="panel" id="s6-p2">
              <div class="term-bar">
                <span class="dot dot-r"></span>
                <span class="dot dot-y"></span>
                <span class="dot dot-g"></span>
                <span class="term-title">ven sync</span>
              </div>
              <div class="p-body">
                <div class="cmd">$ ven lock</div>
                <div class="success">✓ ven.lock v2 · SRI integrity hashes</div>
                <div class="cmd">$ ven sync</div>
                <div class="success">✓ Node 20.20.2 installed</div>
                <div class="success">✓ 34 packages · SHA256 verified</div>
                <div class="out">──</div>
                <div class="cmd">$ ven check --eol</div>
                <div class="out">Runtime EOL: <span class="success">all active</span></div>
                <div class="muted-text" style="margin-top:8px;">CI-safe · non-zero exit on drift</div>
              </div>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
            <div class="badge-row" id="s6-badges">
              <div class="badge badge-green">✓ CI-SAFE</div>
              <div class="badge badge-cyan">⬡ 8 ecosystems</div>
              <div class="badge badge-green">✓ TEAM SYNC</div>
            </div>
            <div style="display:flex; gap:8px;" id="s6-cves">
              <span class="cve-badge safe">0 critical</span>
              <span class="cve-badge safe">0 high</span>
              <span class="cve-badge safe">0 medium</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ Scene 7: CTA ═══ -->
      <div id="scene7" class="scene">
        <div class="glow" id="s7-glow"></div>
        <div class="ghost-ring" id="s7-ring"></div>
        <div class="star-particle" id="s7-st0" style="top:44%; left:43%;"></div>
        <div class="star-particle" id="s7-st1" style="top:42%; left:48%;"></div>
        <div class="star-particle" id="s7-st2" style="top:47%; left:42%;"></div>
        <div class="star-particle" id="s7-st3" style="top:46%; left:55%;"></div>
        <div class="star-particle" id="s7-st4" style="top:43%; left:54%;"></div>
        <div class="star-particle" id="s7-st5" style="top:39%; left:46%;"></div>
        <div class="star-particle" id="s7-st6" style="top:50%; left:57%;"></div>
        <div class="star-particle" id="s7-st7" style="top:51%; left:41%;"></div>
        <div class="corner-bracket tl" id="s7-br-tl" style="opacity:0.15;"></div>
        <div class="corner-bracket tr" id="s7-br-tr" style="opacity:0.15;"></div>
        <div class="corner-bracket bl" id="s7-br-bl" style="opacity:0.15;"></div>
        <div class="corner-bracket br" id="s7-br-br" style="opacity:0.15;"></div>
        <div class="scene-content" id="s7-content">
          <img class="logo" id="s7-logo" src="assets/Ven_logo.png" alt="ven" crossorigin="anonymous" data-hf-skip-duplicate-check />
          <h2 class="headline" id="s7-headline">Start with ven today.</h2>
          <div class="install-block" id="s7-install" style="position:relative;">
            curl -fsSL get.ven.sh | sh
            <div class="corner-bracket tl" style="opacity:0.3; width:20px; height:20px; border-color:#00e639;"></div>
            <div class="corner-bracket tr" style="opacity:0.3; width:20px; height:20px; border-color:#00e639;"></div>
            <div class="corner-bracket bl" style="opacity:0.3; width:20px; height:20px; border-color:#00e639;"></div>
            <div class="corner-bracket br" style="opacity:0.3; width:20px; height:20px; border-color:#00e639;"></div>
          </div>
          <div style="display:flex; align-items:center; gap:16px;">
            <div class="platforms" id="s7-platforms">
              Windows · macOS · Linux
            </div>
            <span class="version-chip" id="s7-version-chip">latest v0.2.1</span>
          </div>
          <div class="download-arrow" id="s7-download">↓ Install now</div>
          <p class="tagline" id="s7-tagline">
            Install once. Switch automatically. Never break.
          </p>
          <div class="footnote" id="s7-footnote">
            MIT License · github.com/bhuwanb23/ven
          </div>
        </div>
      </div>

      <!-- Background music — place a .mp3/.wav file in assets/music.mp3 -->
      <audio
        id="bg-music"
        data-start="0"
        data-duration="120"
        data-track-index="10"
        src="assets/music.mp3"
        data-volume="0.35"
      ></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // ── Transition timing constants ───────────────────────
      const S1_END = 10.5;     // Scene 1 → 2 transition
      const S2_END = 24.5;     // Scene 2 → 3
      const S3_END = 42.5;     // Scene 3 → 4
      const S4_END = 60.5;     // Scene 4 → 5
      const S5_END = 83.5;     // Scene 5 → 6
      const S6_END = 102.5;    // Scene 6 → 7

      // ── Ambient decoratives (seekable on tl) ─────────────
      tl.to("#s1-grid", { backgroundPosition: "48px 48px", duration: 10, ease: "none", repeat: 11 }, 0);
      tl.to("#s1-gt1", { y: 12, rotation: 3.8, duration: 4, ease: "sine.inOut", repeat: 2, yoyo: true }, 0);
      tl.to("#s1-gt2", { y: -10, rotation: -2.8, duration: 5, ease: "sine.inOut", repeat: 2, yoyo: true }, 0);
      tl.to("#s3-glow", { scale: 1.08, opacity: 0.85, duration: 4, ease: "sine.inOut", repeat: 4, yoyo: true }, 26.5);
      tl.to("#s3-ring", { rotation: 15, duration: 5, ease: "sine.inOut", repeat: 3, yoyo: true }, 26.5);
      tl.to("#s4-grid-bg", { backgroundPosition: "48px 48px", duration: 12, ease: "none", repeat: 1 }, 44.5);
      tl.to("#s5-scan", { backgroundPosition: "0px 8px", duration: 4, ease: "none", repeat: 5 }, 63);
      tl.to("#s7-glow", { scale: 1.1, duration: 5, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);
      tl.to("#s7-ring", { rotation: 20, duration: 6, ease: "sine.inOut", repeat: 2, yoyo: true }, 104.5);

      // ── New ambient decoratives ─────────────────────────────
      tl.to("#s1-stripe", { opacity: 0.08, duration: 3, ease: "sine.inOut", repeat: 3, yoyo: true }, 0);
      tl.to("#s1-gt3", { y: 8, rotation: 6.5, duration: 4.5, ease: "sine.inOut", repeat: 2, yoyo: true }, 0);
      tl.to("#s1-gt4", { y: -8, rotation: -5.2, duration: 3.5, ease: "sine.inOut", repeat: 3, yoyo: true }, 0);
      tl.to("#s2-stripe", { opacity: 0.06, duration: 5, ease: "sine.inOut", repeat: 2, yoyo: true, overwrite: "auto" }, S1_END + 0.5);
      tl.to("#s2-progress", { width: "68%", duration: 2, ease: "sine.inOut", repeat: 5, yoyo: true }, S1_END + 1);
      tl.to("#s3-p0", { x: -8, y: -6, duration: 3, ease: "sine.inOut", repeat: 5, yoyo: true }, 26.5);
      tl.to("#s3-p1", { x: 6, y: -8, duration: 4, ease: "sine.inOut", repeat: 4, yoyo: true }, 26.5);
      tl.to("#s3-p2", { x: 8, y: 6, duration: 3.5, ease: "sine.inOut", repeat: 4, yoyo: true }, 26.5);
      tl.to("#s3-p3", { x: -6, y: 8, duration: 4.5, ease: "sine.inOut", repeat: 3, yoyo: true }, 26.5);
      tl.to("#s3-p4", { x: 7, y: -5, duration: 3.8, ease: "sine.inOut", repeat: 4, yoyo: true }, 26.5);
      tl.to("#s3-p5", { x: -7, y: 7, duration: 4.2, ease: "sine.inOut", repeat: 3, yoyo: true }, 26.5);
      tl.to("#s3-pulse-ring", { scale: 1.15, opacity: 0.4, duration: 3, ease: "sine.inOut", repeat: 7, yoyo: true }, 26.5);
      tl.to("#s4-term-badge", { opacity: 0.5, duration: 3, ease: "sine.inOut", repeat: 5, yoyo: true }, 44.5);
      tl.to("#s5-scan-wave", { top: "100%", duration: 6, ease: "none", repeat: 3 }, 63);
      tl.to("#s6-shield", { scale: 1.08, duration: 3, ease: "sine.inOut", repeat: 5, yoyo: true }, S5_END + 0.5);
      tl.to("#s6-ticker", { opacity: 0.4, duration: 1.5, ease: "none", repeat: 13, yoyo: true }, S5_END + 0.5);
      tl.to("#s7-st0", { x: -10, y: -8, duration: 4, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);
      tl.to("#s7-st1", { x: 8, y: -6, duration: 3.5, ease: "sine.inOut", repeat: 4, yoyo: true }, 104.5);
      tl.to("#s7-st2", { x: -6, y: 10, duration: 5, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);
      tl.to("#s7-st3", { x: 10, y: 6, duration: 4.5, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);
      tl.to("#s7-st4", { x: -8, y: -10, duration: 3.8, ease: "sine.inOut", repeat: 4, yoyo: true }, 104.5);
      tl.to("#s7-st5", { x: 6, y: 8, duration: 4.2, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);
      tl.to("#s7-st6", { x: -12, y: 6, duration: 5.5, ease: "sine.inOut", repeat: 2, yoyo: true }, 104.5);
      tl.to("#s7-st7", { x: 8, y: -12, duration: 4.8, ease: "sine.inOut", repeat: 3, yoyo: true }, 104.5);

      // ══════════════ SCENE 1: Chaos (0s → 12s) ════════════
      tl.fromTo("#s1-terminal", { y: -80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: "expo.out" }, 0.2);
      tl.fromTo("#s1-c1", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, 0.6);
      tl.fromTo("#s1-e1", { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" }, 0.85);
      tl.fromTo("#s1-c2", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, 1.3);
      tl.fromTo("#s1-e2", { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" }, 1.55);
      tl.fromTo("#s1-c3", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, 2.2);
      tl.fromTo("#s1-e3", { opacity: 0, x: -6 }, { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" }, 2.45);
      tl.fromTo("#s1-c4", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, 3.2);
      tl.fromTo("#s1-o4", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out" }, 3.5);
      tl.fromTo("#s1-elapsed", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 4.0);
      tl.fromTo("#s1-warn", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(1.4)" }, 3.0);
      tl.fromTo("#s1-err-count", { opacity: 0 }, { opacity: 0.5, duration: 0.4, ease: "power2.out" }, 4.5);
      tl.fromTo("#s1-gt3", { opacity: 0 }, { opacity: 1, duration: 0.8, ease: "sine.out" }, 1.0);
      tl.fromTo("#s1-gt4", { opacity: 0 }, { opacity: 1, duration: 0.8, ease: "sine.out" }, 1.5);
      tl.fromTo("#s1-d1", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, 2.0);
      tl.fromTo("#s1-d2", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, 2.4);

      // ── Transition 1: Blur through (chaos → problem) ──────
      tl.to("#scene1", { filter: "blur(15px)", scale: 1.05, opacity: 0, duration: 0.4, ease: "power2.in" }, S1_END);
      tl.fromTo(
        "#scene2",
        { filter: "blur(15px)", scale: 0.95, opacity: 0 },
        { filter: "blur(0px)", scale: 1, opacity: 1, duration: 0.5, ease: "power2.out" },
        S1_END + 0.15
      );

      // ══════════════ SCENE 2: Problem (12s → 26s) ═════════
      tl.fromTo("#s2-line", { scaleY: 0, transformOrigin: "top" }, { scaleY: 1, duration: 0.5, ease: "power2.out" }, S1_END + 0.45);
      tl.fromTo("#s2-eyebrow", { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power3.out" }, S1_END + 0.55);
      tl.fromTo("#s2-headline", { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: "power3.out" }, S1_END + 0.65);
      tl.fromTo("#s2-body", { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, S1_END + 0.85);
      tl.fromTo("#s2-terminal", { x: 80, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: "expo.out" }, S1_END + 0.75);
      tl.fromTo("#s2-c1", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S1_END + 1.0);
      tl.fromTo("#s2-o1", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S1_END + 1.25);
      tl.fromTo("#s2-c2", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S1_END + 1.5);
      tl.fromTo("#s2-o2", { x: -10, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: "power2.out" }, S1_END + 1.75);
      tl.fromTo("#s2-o3", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "none" }, S1_END + 2.0);
      tl.fromTo("#s2-ghost", { opacity: 0 }, { opacity: 1, duration: 0.8, ease: "sine.out" }, S1_END + 0.5);
      tl.fromTo("#s2-stripe", { opacity: 0 }, { opacity: 0.04, duration: 0.8, ease: "sine.out" }, S1_END + 0.3);
      tl.fromTo("#s2-versions", { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, S1_END + 0.7);
      tl.fromTo("#s2-d1", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, S1_END + 1.0);
      tl.fromTo("#s2-d2", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, S1_END + 1.3);
      tl.fromTo("#s2-progress-wrap", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, S1_END + 1.5);

      // ── Transition 2: Blur crossfade (problem → meet ven) ─
      tl.to("#scene2", { filter: "blur(12px)", opacity: 0, duration: 0.35, ease: "power2.in" }, S2_END);
      tl.fromTo(
        "#scene3",
        { filter: "blur(12px)", opacity: 0 },
        { filter: "blur(0px)", opacity: 1, duration: 0.45, ease: "power3.out" },
        S2_END + 0.15
      );

      // ══════════ SCENE 3: Meet ven + Auto-Switch (26s → 44s) ═════
      tl.fromTo("#s3-logo", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.8, ease: "back.out(1.6)" }, S2_END + 0.4);
      tl.fromTo("#s3-logo-text", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: "power3.out" }, S2_END + 0.6);
      tl.fromTo("#s3-subtitle", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, S2_END + 0.85);
      tl.fromTo("#s3-version-meta", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, S2_END + 0.95);
      tl.fromTo("#s3-pulse-ring", { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 0.3, duration: 0.8, ease: "expo.out" }, S2_END + 0.5);
      tl.fromTo("#s3-logo-frame", { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 0.6, duration: 0.6, ease: "expo.out" }, S2_END + 0.3);

      // Auto-switch panel assembles after 4s hold
      tl.fromTo("#s3-tree", { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "expo.out" }, S2_END + 4.5);
      tl.fromTo("#s3-term", { x: 80, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, S2_END + 4.6);
      tl.fromTo("#s3-sw-c1", { opacity: 0 }, { opacity: 1, duration: 0.2, ease: "none" }, S2_END + 5.0);
      tl.fromTo("#s3-sw-o1", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, S2_END + 5.2);
      tl.fromTo("#s3-sw-c2", { opacity: 0 }, { opacity: 1, duration: 0.2, ease: "none" }, S2_END + 5.6);
      tl.fromTo("#s3-sw-o2", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(2)" }, S2_END + 5.8);
      tl.fromTo("#s3-sw-info", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, S2_END + 6.2);

      // ── Transition 3: Zoom through (meet → languages) ────
      tl.to("#scene3", { scale: 1.08, filter: "blur(18px)", opacity: 0, duration: 0.35, ease: "power3.in" }, S3_END);
      tl.fromTo(
        "#scene4",
        { scale: 0.88, filter: "blur(18px)", opacity: 0 },
        { scale: 1, filter: "blur(0px)", opacity: 1, duration: 0.5, ease: "expo.out" },
        S3_END + 0.12
      );

      // ══════════════ SCENE 4: Languages (44s → 62s) ════════
      tl.fromTo("#s4-headline", { x: -50, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: "power3.out" }, S3_END + 0.45);
      tl.fromTo("#s4-sub", { x: -30, opacity: 0 }, { x: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, S3_END + 0.6);
      tl.fromTo(
        "#s4-grid .lang-card",
        { y: 50, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.45, ease: "back.out(1.2)", stagger: 0.07 },
        S3_END + 0.75
      );
      tl.fromTo("#s4-term-badge", { opacity: 0 }, { opacity: 0.3, duration: 0.6, ease: "sine.out" }, S3_END + 0.5);
      tl.fromTo("#s4-d1", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, S3_END + 1.0);
      tl.fromTo("#s4-d2", { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, S3_END + 1.3);
      tl.fromTo("#s4-grid .version-chip", { opacity: 0, scale: 0.5 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(1.4)", stagger: 0.06 }, S3_END + 2.5);

      // ── Transition 4: Push slide up (languages → ghost) ──
      tl.to("#scene4", { y: -60, filter: "blur(20px)", opacity: 0, duration: 0.35, ease: "power2.in" }, S4_END);
      tl.fromTo(
        "#scene5",
        { y: 80, filter: "blur(20px)", opacity: 0 },
        { y: 0, filter: "blur(0px)", opacity: 1, duration: 0.5, ease: "power2.out" },
        S4_END + 0.15
      );

      // ══════════════ SCENE 5: Ghost Scan (62s → 85s) ════════
      tl.fromTo("#s5-headline", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: "power3.out" }, S4_END + 0.45);
      tl.fromTo("#s5-sub", { y: 25, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, S4_END + 0.6);
      tl.fromTo("#s5-toml", { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.55, ease: "expo.out" }, S4_END + 0.7);
      tl.fromTo("#s5-terminal", { x: 60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, S4_END + 0.8);
      tl.fromTo("#s5-o1", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "none" }, S4_END + 1.0);
      tl.fromTo("#s5-c1", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S4_END + 1.3);
      tl.fromTo("#s5-o2", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "none" }, S4_END + 1.6);
      tl.fromTo("#s5-o3", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S4_END + 1.9);
      tl.fromTo("#s5-ghost1", { x: -10, opacity: 0, scale: 0.9 }, { x: 0, opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.6)" }, S4_END + 2.1);
      tl.fromTo("#s5-ghost2", { x: -10, opacity: 0, scale: 0.9 }, { x: 0, opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.6)" }, S4_END + 2.4);
      tl.fromTo("#s5-ghost3", { x: -10, opacity: 0, scale: 0.9 }, { x: 0, opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.6)" }, S4_END + 2.7);
      tl.fromTo("#s5-c2", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "none" }, S4_END + 3.2);
      tl.fromTo("#s5-o4", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, S4_END + 3.5);
      tl.fromTo("#s5-stats", { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, S4_END + 4.0);
      tl.fromTo("#s5-ghost-toml", { opacity: 0 }, { opacity: 1, duration: 1.0, ease: "sine.out" }, S4_END + 0.5);
      tl.fromTo("#s5-scan-wave", { top: 0, opacity: 0 }, { opacity: 0.25, duration: 0.3, ease: "power2.out" }, S4_END + 0.5);
      tl.fromTo("#s5-br-tl, #s5-br-tr, #s5-br-bl, #s5-br-br", { opacity: 0 }, { opacity: 0.2, duration: 0.4, ease: "power2.out" }, S4_END + 0.5);
      tl.fromTo("#s5-ghost-chart", { opacity: 0, x: -10 }, { opacity: 1, x: 0, duration: 0.5, ease: "power2.out" }, S4_END + 1.5);

      // ── Transition 5: Directional slide (ghost → security) ─
      tl.to("#scene5", { x: -180, filter: "blur(12px)", opacity: 0, duration: 0.4, ease: "power3.in" }, S5_END);
      tl.fromTo(
        "#scene6",
        { x: 180, filter: "blur(12px)", opacity: 0 },
        { x: 0, filter: "blur(0px)", opacity: 1, duration: 0.45, ease: "power3.out" },
        S5_END + 0.15
      );

      // ══════════════ SCENE 6: Security (85s → 104s) ═════════
      tl.fromTo("#s6-headline", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: "power3.out" }, S5_END + 0.45);
      tl.fromTo("#s6-sub", { y: 25, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, S5_END + 0.6);
      tl.fromTo("#s6-p1", { x: -50, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, S5_END + 0.7);
      tl.fromTo("#s6-p2", { x: 50, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, S5_END + 0.85);
      tl.fromTo("#s6-bar0", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.2);
      tl.fromTo("#s6-bar1", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.35);
      tl.fromTo("#s6-bar2", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.5);
      tl.fromTo("#s6-bar3", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.65);
      tl.fromTo("#s6-bar4", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.8);
      tl.fromTo("#s6-bar5", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 1.95);
      tl.fromTo("#s6-bar6", { scaleX: 0, transformOrigin: "left" }, { scaleX: 1, duration: 0.3, ease: "power2.out" }, S5_END + 2.1);
      tl.fromTo("#s6-badges", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, S5_END + 2.5);
      tl.fromTo("#s6-shield", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.6)" }, S5_END + 0.4);
      tl.fromTo("#s6-cves", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, S5_END + 2.8);
      // network nodes fade in staggered
      tl.fromTo("#s6-n0", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2)" }, S5_END + 0.6);
      tl.fromTo("#s6-n1", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2)" }, S5_END + 0.8);
      tl.fromTo("#s6-n2", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2)" }, S5_END + 1.0);
      tl.fromTo("#s6-l0, #s6-l1", { scaleX: 0, opacity: 0 }, { scaleX: 1, opacity: 1, duration: 0.4, ease: "power2.out" }, S5_END + 0.9);

      // ── Transition 6: Slow dissolve (security → CTA) ─────
      tl.to("#scene6", { filter: "blur(10px)", opacity: 0, duration: 0.5, ease: "sine.inOut" }, S6_END);
      tl.fromTo(
        "#scene7",
        { filter: "blur(10px)", opacity: 0 },
        { filter: "blur(0px)", opacity: 1, duration: 0.6, ease: "sine.inOut" },
        S6_END + 0.15
      );

      // ══════════════ SCENE 7: CTA (104s → 120s) ═════════════
      tl.fromTo("#s7-logo", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.8, ease: "back.out(1.6)" }, S6_END + 0.45);
      tl.fromTo("#s7-headline", { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 0.65, ease: "power3.out" }, S6_END + 0.65);
      tl.fromTo("#s7-install", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "expo.out" }, S6_END + 0.85);
      tl.fromTo("#s7-platforms", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, S6_END + 1.1);
      tl.fromTo("#s7-tagline", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, S6_END + 1.3);
      tl.fromTo("#s7-footnote", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, S6_END + 1.55);
      tl.fromTo("#s7-version-chip", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(1.6)" }, S6_END + 1.8);
      tl.fromTo("#s7-download", { opacity: 0, y: -8 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, S6_END + 2.0);
      tl.fromTo("#s7-br-tl, #s7-br-tr, #s7-br-bl, #s7-br-br", { opacity: 0 }, { opacity: 0.15, duration: 0.5, ease: "sine.out" }, S6_END + 0.3);

      // ── Final fade out (only scene with exit animations) ──
      tl.to("#s7-content > *", { opacity: 0, y: -20, duration: 1.2, stagger: 0.08, ease: "power2.in" }, 116);
      tl.to("#scene7", { opacity: 0, duration: 0.8, ease: "power1.in" }, 117.5);
      tl.set("#scene7", { visibility: "hidden" }, 118.3);

      window.__timelines["ven-promo-v2"] = tl;
    </script>
  </body>
</html>
